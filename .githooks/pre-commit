#!/usr/bin/env bash
# Pre-commit guardrail. Host checks always run; the PHP checks mirror public CI
# plus PHPStan and run only when the Docker web container is up, so a checkout
# with the stack down can still commit. Everything checks the working tree, not
# the staged index. Bypass one commit with `git commit --no-verify`.
# Install with `./scripts/dev.sh install-hooks`; see docs/DEV.md "Git hooks".
set -euo pipefail
cd "$(dirname "$0")/.."

./scripts/check-balance-writes.sh
./scripts/test-dev.sh
./scripts/test-pre-push.sh

python3 scripts/check-artifacts.py

if command -v gitleaks >/dev/null 2>&1; then
    # `dir` needs gitleaks >= 8.19; older versions fail loudly under set -e.
    gitleaks dir . --no-banner --redact
else
    echo "pre-commit: gitleaks not installed; skipped working-tree secret scan."
fi

project=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' .env 2>/dev/null | tail -n1)
project="${COMPOSE_PROJECT_NAME:-${project:-default}}"
if docker compose ps web --format '{{.State}}' 2>/dev/null | grep -qx running; then
    ./scripts/dev.sh test check
else
    echo "pre-commit: web container not running in compose project '$project'; skipped php lint/unit/phpstan."
fi

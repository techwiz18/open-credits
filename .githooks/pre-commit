#!/usr/bin/env bash
# Pre-commit guardrail. Host checks always run; the PHP checks run through the
# docker adapter only when the web container is up, so a checkout with the
# stack down can still commit. Everything checks the working tree, not the
# staged index. Bypass one commit with `git commit --no-verify`.
# Install with `./scripts/dev.sh install-hooks`; the step contract lives in
# scripts/check.sh (`./scripts/check.sh list`) and docs/DEV.md "Git hooks".
set -euo pipefail
cd "$(dirname "$0")/.."

# artifacts + balance-writes + the CLI smoke test + the gitleaks tree scan.
./scripts/check.sh host

if docker compose ps web --format '{{.State}}' 2>/dev/null | grep -qx running; then
    ./scripts/dev.sh test check
else
    echo "pre-commit: web container not running; skipped php lint/unit/phpstan."
fi

# XenForo runtime (licensed, dev-only) — never commit
src/
# Build artifacts (rebuilt via xf-addon:build-release)
addon-src/OpenCredits/Credits/_releases/
addon-src/OpenCredits/Credits/_data/
# Docker data
db_data/
# Env
.env
# Session handoff notes (may contain dev-only credentials) — never commit
HANDOFF.md
# OS
.DS_Store
Thumbs.db
# PHP
vendor/
*.log
# Local bridge/screenshot workspace (visual QA lives here, never commit)
.opencode/
# Regenerated by xf-addon:build-release on every build
addon-src/OpenCredits/Credits/hashes.json

# Allow add-on JS shipped under _files (XF js/vendor convention)
!addon-src/OpenCredits/Credits/_files/js/vendor/
!addon-src/OpenCredits/Credits/_files/js/vendor/**

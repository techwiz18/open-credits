# No overrides needed — defaults to directory project name.
# Copy to .env only if you need custom ports.
# WEB_PORT=8082
#
# Sharing one installed stack between worktrees? Start it with
# `COMPOSE_PROJECT_NAME=open-credits ./scripts/dev.sh up`; `up` records the
# name here so later commands and the pre-commit hook address the same stack:
# COMPOSE_PROJECT_NAME=open-credits

{"action": "str_replace", "description": "Shows primary credit balance in member profile stats", "enabled": true, "execution_order": 10, "find": "\t<!--[XF:stat_pairs:below_trophies]-->", "modification_key": "oc_credits_profile_stats", "replace": "\t<!--[XF:stat_pairs:below_trophies]-->\n\t<xf:if is=\"$xf.options.ocShowProfileStats\">\n\t<xf:if is=\"$user.oc_primary\">\n\t\t<dl class=\"pairs pairs--rows pairs--rows--centered fauxBlockLink\">\n\t\t\t<dt>{$user.oc_primary.title}</dt>\n\t\t\t<dd>\n\t\t\t\t<a href=\"{{ link('credits/member', '', {'user_id': $user.user_id}) }}\" rel=\"nofollow\" class=\"fauxBlockLink-linkRow u-concealed\">\n\t\t\t\t\t{$user.oc_primary.prefix}{$user.oc_primary.balance|number($user.oc_primary.decimals)}{$user.oc_primary.suffix}\n\t\t\t\t</a>\n\t\t\t</dd>\n\t\t</dl>\n\t</xf:if>\n\t</xf:if>", "template": "member_macros", "type": "public"}
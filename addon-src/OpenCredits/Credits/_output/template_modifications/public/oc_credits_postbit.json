{"action": "str_replace", "description": "Shows visible credit balances in postbit user extras", "enabled": true, "execution_order": 10, "find": "\t\t\t\t\t<xf:if is=\"$extras.reaction_score\">\n\t\t\t\t\t\t<dl class=\"pairs pairs--justified\">\n\t\t\t\t\t\t\t<dt>{{ phrase('reaction_score') }}</dt>\n\t\t\t\t\t\t\t<dd>{$user.reaction_score|number}</dd>\n\t\t\t\t\t\t</dl>\n\t\t\t\t\t</xf:if>", "modification_key": "oc_credits_postbit", "replace": "\t\t\t\t\t<xf:if is=\"$extras.reaction_score\">\n\t\t\t\t\t\t<dl class=\"pairs pairs--justified\">\n\t\t\t\t\t\t\t<dt>{{ phrase('reaction_score') }}</dt>\n\t\t\t\t\t\t\t<dd>{$user.reaction_score|number}</dd>\n\t\t\t\t\t\t</dl>\n\t\t\t\t\t</xf:if>\n\t\t\t\t\t<xf:if is=\"$xf.options.ocShowPostbit\">\n\t\t\t\t\t<xf:foreach loop=\"$user.oc_balances\" value=\"$ocBalance\">\n\t\t\t\t\t\t<dl class=\"pairs pairs--justified\">\n\t\t\t\t\t\t\t<dt>{$ocBalance.title}</dt>\n\t\t\t\t\t\t\t<dd><a href=\"{{ link('credits', '', {'currency_id': $ocBalance.currency_id}) }}\" class=\"u-concealed\">{$ocBalance.prefix}{$ocBalance.balance|number($ocBalance.decimals)}{$ocBalance.suffix}</a></dd>\n\t\t\t\t\t\t</dl>\n\t\t\t\t\t</xf:foreach>\n\t\t\t\t\t</xf:if>", "template": "message_macros", "type": "public"}
<?xml version="1.0" encoding="utf-8"?>
<templates>
  <template type="public" title="credits_index" version_id="300" version_string="0.3.0"><![CDATA[<xf:title>{{ phrase('oc_credits_history') }}</xf:title>

<div class="block">
    <div class="block-container">
        <div class="block-body">
            <div class="block-row block-row--separated">
                <div class="pairs pairs--columns pairs--fluid">
                    <dl class="pairs pairs--justified">
                        <dt>{{ phrase('oc_credits') }}</dt>
                        <dd>{$currency.prefix}{$balance|number(2)}{$currency.suffix}</dd>
                    </dl>
                </div>
                <a href="{{ link('credits/transfer') }}" class="button">{{ phrase('oc_transfer_to') }}</a>
            </div>
        </div>
    </div>
</div>

<div class="block">
    <div class="block-container">
        <h3 class="block-header">{{ phrase('oc_credits_history') }}</h3>
        <div class="block-body">
            <xf:if is="$transactions is not empty">
                <xf:foreach loop="$transactions" value="$txn">
                    <div class="block-row">
                        <div class="pairs pairs--justified">
                            <dt>{$txn.trigger}</dt>
                            <dd><xf:if is="$txn.amount > 0">+</xf:if>{$txn.amount|number(2)} &middot; {{ date($txn.log_date) }}</dd>
                        </div>
                    </div>
                </xf:foreach>
            <xf:else />
                <div class="block-row">{{ phrase('no_results_found') }}</div>
            </xf:if>
        </div>
        <xf:if is="$total > $perPage">
            <div class="block-footer">
                <xf:pagenav page="{$page}" perpage="{$perPage}" total="{$total}" link="credits" />
            </div>
        </xf:if>
    </div>
</div>
]]></template>
  <template type="public" title="credits_transfer" version_id="600" version_string="0.6.0"><![CDATA[<xf:title>{{ phrase('oc_transfer_to') }}</xf:title>

<div class="block">
    <div class="block-container">
        <div class="block-body">
            <div class="block-row">
                {{ phrase('oc_credits') }}: <strong>{$currency.prefix}{$balance|number(2)}{$currency.suffix}</strong>
            </div>
        </div>
    </div>
</div>

<xf:form action="{{ link('credits/transfer-save') }}" class="block" ajax="true">
    <div class="block-container">
        <div class="block-body">
            <xf:textboxrow name="to" value="{$to}" label="To user"
                placeholder="Username" required="true"
                data-xf-init="auto-complete" data-ac-url="{{ link('members/find') }}"
                data-single="true" minlength="2" />
            <xf:textboxrow name="amount" type="number" step="0.01" min="0.01" label="Amount"
                placeholder="0.00" required="true" />
        </div>
        <xf:submitrow submit="{{ phrase('oc_transfer') }}" />
    </div>
</xf:form>
]]></template>
</templates>
